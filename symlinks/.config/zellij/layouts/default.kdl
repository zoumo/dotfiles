// Managed by ~/.dotfiles/symlinks/.config/zellij/layouts/default.kdl.
layout {
    // Keep the standard Zellij tab and status bars around the workspace.
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // Four equally sized panes. New shells inherit the directory Zellij was
    // started from, and the top-left pane receives the initial focus.
    tab {
        pane split_direction="vertical" {
            pane size="50%" split_direction="horizontal" {
                pane focus=true
                pane
            }
            pane split_direction="horizontal" {
                pane
                pane
            }
        }
    }
}
